# Environment Variables Template
# Copy this file to .env and fill in your actual values

# Google Maps API Key (for LiveGoogleMap component)
# Get from: https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Backend API URL (for production deployment)
VITE_API_URL=http://localhost:5000

# Development Environment
NODE_ENV=development

# Optional: Analytics and Monitoring
VITE_ANALYTICS_ID=your_analytics_id_here

# Optional: Emergency Services API
VITE_EMERGENCY_API_KEY=your_emergency_api_key_here

# Backend Configuration (if using separate .env for backend)
FLASK_ENV=development
FLASK_DEBUG=True
DATABASE_URL=sqlite:///traffic_signals.db
