# 🔑 GOOGLE MAPS API CONFIGURATION
# ===================================
# TO FIX THE BLANK MAP ISSUE:
# 1. Go to https://console.cloud.google.com/
# 2. Create a project or select existing one
# 3. Enable these APIs: Maps JavaScript API, Places API, Directions API
# 4. Create an API key in "Credentials" section
# 5. Replace the values below with your actual API key
# 6. Restart your development server (npm run dev)

# Google Maps JavaScript API Key (for frontend React component)
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Google Maps Backend API Key (for Python Flask service) 
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Backend API URLs
VITE_API_URL=http://localhost:5000
VITE_MAPS_API_URL=http://localhost:5001

# Development Environment
NODE_ENV=development

# Optional: Analytics and Monitoring
VITE_ANALYTICS_ID=your_analytics_id_here

# Optional: Emergency Services API
VITE_EMERGENCY_API_KEY=your_emergency_api_key_here

# Backend Configuration (if using separate .env for backend)
FLASK_ENV=development
FLASK_DEBUG=True
DATABASE_URL=sqlite:///traffic_signals.db
